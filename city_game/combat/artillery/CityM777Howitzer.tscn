[node name="Anchors" type="Node3D" parent="." unique_id=155477353]
editor_description = "Authoring 锚点总根。这里只放单一职责的可视化调节点，运行时会把这些 transform 复制到 pivot / FX / 弹道 / 音频节点。以后手调请优先改这里，不要直接改 FirePresentationRoot 下面的运行时附着节点。"
transform = Transform3D(10, 0, 0, 0, 10, 0, 0, 0, 10, 0, 3.4, 0)

[node name="YawPivotAnchor" type="Marker3D" parent="Anchors" unique_id=1691850120]
editor_description = "Yaw 轴 authored 锚点。它定义 ModelRoot/YawPivot 的本地安装位置，只负责火炮水平回转轴的装配基准。改它会整体改变上车架与炮管回转中心，不负责 muzzle FX、弹道原点、火绳或音频。"
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.18339898, 0.036200494)

[node name="PitchPivotAnchor" type="Marker3D" parent="Anchors" unique_id=587547894]
editor_description = "Pitch 轴 authored 锚点。它定义 ModelRoot/YawPivot/PitchPivot 的本地安装位置，只负责炮管俯仰轴的装配基准。改它会影响炮管绕哪个点抬升/下压，但不应该被拿去兼顾 muzzle FX、弹道原点、火绳或音频。"
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.34541282, 0.08429819)

[node name="MuzzleFxAnchor" type="Marker3D" parent="Anchors" unique_id=1449674370]
editor_description = "炮口 FX authored 锚点。它只负责运行时 MuzzleFxRig 的位置和朝向，而 FlashBurst / SmokeBurst 都只是这个 rig 下面的局部几何。只要你想调炮口火焰/烟雾从哪里喷、朝哪边喷，就改这里；它不应该再承担弹道原点、音频、火绳或任何自动吸附到 visible tip 的责任。"
transform = Transform3D(1, 0, 0, 0, 0.9855944, 0.16912594, 0, -0.16912594, 0.9855944, -0.0001278516, 0.5680229, 0.64017034)

[node name="MuzzleBallisticsAnchor" type="Marker3D" parent="Anchors" unique_id=600762278]
editor_description = "弹道 authored 锚点。它只负责炮弹发射原点与前向方向，运行时会复制到 MuzzleBallisticsProbe，再由 solver / fire mission / projectile 起点使用。改这里会影响射击诸元反解、发射原点与命中链；它不应该拖着 muzzle flash/smoke 一起移动。"
transform = Transform3D(1, 0, 0, 0, 0.7576448, -0.65266716, 0, 0.65266716, 0.7576448, -0.0001278516, 0.5680229, 0.64017034)

[node name="LanyardAnchor" type="Marker3D" parent="Anchors" unique_id=633395980]
editor_description = "火绳 authored 锚点。它只负责 Lanyard / LanyardLine 的炮身附着起点，也就是玩家拉火绳时那根绳子从炮上哪里出发。改这里只应影响火绳视觉与绳线起点，不应该顺带改变 FireAudio 或弹道原点。"
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.0011971176, 0.29134598, -0.25388214)

[node name="FireAudioAnchor" type="Marker3D" parent="Anchors" unique_id=620801666]
editor_description = "开火音频 authored 锚点。它只负责 FireAudio 的 3D 空间位置，用来决定炮声从炮体哪个位置发出。改这里只应影响音源位置与衰减感受，不应该带动火绳、muzzle FX 或弹道原点。"
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.0011971176, 0.29134598, -0.25388214)
